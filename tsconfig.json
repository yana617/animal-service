{
   "compilerOptions": {
      "lib": [
         "ES2020",
         "DOM"
      ],
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "esModuleInterop": true,
      "strictNullChecks": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "types": ["node", "jest"]
   },
   "include": ["src/**/*", "app.ts", "index.ts"]
}